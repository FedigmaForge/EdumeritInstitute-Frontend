{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/mock-test/*/*/**",
        "destination": "/mock-test/view/index.html"
      },
      {
        "source": "/mock-test/*/*",
        "destination": "/mock-test/view/index.html"
      },
      {
        "source": "/blog/*/**",
        "destination": "/blog/view/index.html"
      },
      {
        "source": "/blog/*",
        "destination": "/blog/view/index.html"
      }
    ]
  }
}
